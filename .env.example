# ==============================================
# MK Designs Studio - Environment Variables
# ==============================================
# Copy this file to .env.local for development
# Set these in your hosting platform for production

# ==============================================
# NEXTAUTH CONFIGURATION (REQUIRED)
# ==============================================

# Generate with: openssl rand -base64 32
# MUST be at least 32 characters long
# CRITICAL: Change this in production!
NEXTAUTH_SECRET=your-random-secret-here-replace-with-actual-secret-string

# Your application URL
# Development: http://localhost:3000
# Production: https://your-domain.com (NO TRAILING SLASH)
NEXTAUTH_URL=http://localhost:3000

# ==============================================
# ADMIN CREDENTIALS (REQUIRED)
# ==============================================

# Admin username for dashboard access
# SECURITY: Change default in production
ADMIN_USERNAME=admin

# Admin password for dashboard access
# SECURITY: Use strong password (12+ characters, mixed case, numbers, symbols)
ADMIN_PASSWORD=mkdesigns@2024

# ==============================================
# DATABASE CONFIGURATION (OPTIONAL)
# ==============================================

# MongoDB Connection String
# Local: mongodb://localhost:27017/mkdesigns
# MongoDB Atlas: mongodb+srv://username:password@cluster.xxxxx.mongodb.net/mkdesigns
# Leave empty to use fallback hardcoded data
MONGODB_URI=mongodb://localhost:27017/mkdesigns

# ==============================================
# DEPLOYMENT NOTES
# ==============================================
# 
# FOR PRODUCTION DEPLOYMENT:
# 
# 1. Generate a secure NEXTAUTH_SECRET:
#    openssl rand -base64 32
# 
# 2. Set NEXTAUTH_URL to your production domain:
#    https://your-domain.com
# 
# 3. Change ADMIN_USERNAME and ADMIN_PASSWORD
#    to secure credentials
# 
# 4. Set MongoDB connection string (optional)
# 
# 5. Never commit .env.local to Git!
# 
# ==============================================
# PLATFORM-SPECIFIC INSTRUCTIONS
# ==============================================
# 
# VERCEL:
# Dashboard → Settings → Environment Variables
# 
# NETLIFY:
# Site Settings → Build & Deploy → Environment
# 
# ==============================================
